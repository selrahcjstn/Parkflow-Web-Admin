# ParkFlow Web Admin Environment Variables

# Development API uses the local Vite proxy; release builds require an explicit HTTPS /api URL.
VITE_API_URL=/api

# Backend URL (used by Vite proxy in dev)
# Local: http://localhost:5044
# Production: configure the verified HTTPS API origin; no HTTP fallback.
VITE_BACKEND_URL=http://localhost:5044

# SignalR Notifications Hub URL
VITE_SIGNALR_HUB_URL=http://localhost:5044/hubs/notifications

# Release: set VITE_API_URL to the verified HTTPS endpoint ending in /api.
# Omit VITE_SIGNALR_HUB_URL to derive it from that API, or configure the same HTTPS authority.
